######################################################################
#                        最小mujoco测试文件                            #
######################################################################
<mujoco model="minimal_scene">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <worldbody>
    <light pos="0 0 3"/>

    <geom
      name="floor"
      type="plane"
      size="2 2 0.1"
      rgba="0.8 0.8 0.8 1"
    />

    <body name="falling_box" pos="0 0 1">
      <freejoint/>
      <geom
        name="box"
        type="box"
        size="0.1 0.1 0.1"
        mass="1"
        rgba="0.2 0.5 0.8 1"
      />
    </body>
  </worldbody>
</mujoco>

#定义了地面，灯光，蓝色方块，重力和仿真步长。
#用于测试mujoco是否能正常加载 显示，推进和重置