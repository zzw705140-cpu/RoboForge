        <light pos="1.0 1.0 1.5" dir="-0.2 -0.2 -1" specular="0.3 0.3 0.3" directional="true" castshadow="false" />
       
       
        <!-- ===== 相机：沿用 front / handcam_rgb 接口；腕部相机由 panda.xml 提供 ===== -->
        <camera name="front" pos="1.1 0 0.8" quat="0.6532815 0.2705981 0.2705981 0.6532815" fovy="50" />
        <camera name="birdview" pos="0.42 0 1.4" quat="1 0 0 0" fovy="50" />
