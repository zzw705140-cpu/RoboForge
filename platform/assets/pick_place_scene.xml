<?xml version='1.0' encoding='utf-8'?>
<mujoco model="roboforge_pick_place">
    <!-- ===== 来源：robosuite master 的 bins_arena.xml 与四组物体/visual XML；许可证见 pick_place_resources ===== -->
    <!-- ===== 布局适配：箱体 x/y 尺寸缩放至 70%/50%，降低至地面；物体尺寸与接触参数保留原版；移除高台装饰腿 ===== -->
  
  
    <include file="panda.xml" />
    <option timestep="0.002" noslip_iterations="5" noslip_tolerance="0" />
    <statistic center="0.35 0 0.2" extent="0.9" />
    <visual>
        <global azimuth="160" elevation="-35" offheight="128" offwidth="128" />
        <headlight diffuse="0.6 0.6 0.6" ambient="0.4 0.4 0.4" />
    </visual>
    <asset>


        <!-- ===== arenas/bins_arena.xml 的资源 ===== -->
        <texture builtin="gradient" height="256" rgb1=".9 .9 1." rgb2=".2 .3 .4" type="skybox" width="256" />
        <texture file="pick_place_resources/textures/light-gray-floor-tile.png" type="2d" name="pp_texplane" />
        <material name="pp_floorplane" reflectance="0.01" shininess="0.0" specular="0.0" texrepeat="2 2" texture="pp_texplane" texuniform="true" />
        <texture file="pick_place_resources/textures/steel-brushed.png" type="cube" name="pp_tex-steel-brushed" />
        <material name="pp_table_legs_metal" reflectance="0.8" shininess="0.8" texrepeat="1 1" texture="pp_tex-steel-brushed" />
        <texture file="pick_place_resources/textures/light-gray-plaster.png" type="2d" name="pp_tex-light-gray-plaster" />
        <material name="pp_walls_mat" reflectance="0.0" shininess="0.1" specular="0.1" texrepeat="3 3" texture="pp_tex-light-gray-plaster" texuniform="true" />
        <texture file="pick_place_resources/textures/light-wood.png" type="2d" name="pp_tex-light-wood" />
        <texture file="pick_place_resources/textures/dark-wood.png" type="2d" name="pp_tex-dark-wood" />
        <material name="pp_light-wood" reflectance="0" texrepeat="15 15" texture="pp_tex-light-wood" texuniform="true" />
        <material name="pp_dark-wood" reflectance="0" texrepeat="5 5" texture="pp_tex-dark-wood" texuniform="true" />
        <!-- ===== objects/milk.xml 的资源 ===== -->
        <mesh file="pick_place_resources/objects/meshes/milk.msh" name="pp_milk_milk_mesh" scale="0.9 0.9 0.9" />
        <texture file="pick_place_resources/textures/ceramic.png" name="pp_milk_tex-ceramic" type="2d" />
        <material name="pp_milk_ceramic" reflectance="0.5" texrepeat="1 1" texture="pp_milk_tex-ceramic" texuniform="true" />
        <!-- ===== objects/milk-visual.xml 的资源 ===== -->
        <mesh file="pick_place_resources/objects/meshes/milk.stl" name="pp_milk_visual_milk_mesh" scale="0.9 0.9 0.9" />
        <!-- ===== objects/bread.xml 的资源 ===== -->
        <mesh file="pick_place_resources/objects/meshes/bread.stl" name="pp_bread_bread_mesh" scale="0.8 0.8 0.8" />
        <texture file="pick_place_resources/textures/bread.png" type="2d" name="pp_bread_tex-bread" />
        <material name="pp_bread_bread" reflectance="0.7" texrepeat="15 15" texture="pp_bread_tex-bread" texuniform="true" />
        <!-- ===== objects/bread-visual.xml 的资源 ===== -->
        <mesh file="pick_place_resources/objects/meshes/bread.stl" name="pp_bread_visual_bread_mesh" scale="0.8 0.8 0.8" />
        <!-- ===== objects/cereal.xml 的资源 ===== -->
        <mesh file="pick_place_resources/objects/meshes/cereal.msh" name="pp_cereal_cereal_mesh" />
        <texture type="2d" file="pick_place_resources/textures/cereal.png" rgb1="1 1 1" name="pp_cereal_tex-cereal" />
        <material name="pp_cereal_cereal" reflectance="0.5" texrepeat="1 1" texture="pp_cereal_tex-cereal" texuniform="false" />
