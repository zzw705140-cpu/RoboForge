            <geom pos="0 0 0" size="0.14 0.125 0.02" type="box" group="0" friction="1 0.005 0.0001" rgba="0 0 0 0" />
            <geom pos="0 0 0" size="0.14 0.125 0.02" type="box" conaffinity="0" contype="0" group="1" material="pp_dark-wood" />
